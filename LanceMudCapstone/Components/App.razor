<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/default-base.css" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["LanceMudCapstone.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="/js/cookies.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject] SessionState SessionState { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;
    [Inject] IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] NavigationManager Nav { get; set;  } = default!;

    private HttpClient Api => HttpClientFactory.CreateClient("ServerAPI");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Console.WriteLine("OAR FIRED");
        if (!firstRender) return;
        if (SessionState.UserId != null) return;

        var cookieValue = await JS.InvokeAsync<string>("cookieHelper.readCookie", "session");

        if (string.IsNullOrEmpty(cookieValue)) return;

        var response = await Api.GetAsync($"/api/auth/validate/{cookieValue}");

        if (!response.IsSuccessStatusCode) return;

        var user = await response.Content.ReadFromJsonAsync<User>();

        if (user is null) return;

        await SessionState.SetUserAsync(user.UserId, user.Username, user.ProfilePictureId);

        Nav.NavigateTo("/character", forceLoad: false);
    }

    protected override async Task OnInitializedAsync()
    {
        await SessionState.InitializeAsync();
    }

}