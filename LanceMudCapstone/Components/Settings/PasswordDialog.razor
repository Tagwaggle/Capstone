@inject IHttpClientFactory httpClientFactory
@inject DialogService DialogService
@inject SessionState SessionState
@inherits ComponentBase
@namespace LanceMudCapstone.Components.Settings


<RadzenCard class="password-dialog-card">
	<RadzenText TextStyle="TextStyle.H6" class="dialog-title">
		Change Password
	</RadzenText>

	<RadzenTemplateForm TItem="PasswordModel" Data="@model" Submit="@Submit">
		<RadzenStack Gap="1rem">
			<RadzenPassword @bind-Value="model.OldPassword" Name="OldPassword" Placeholder="Old Password" Style="width: 100%" />
			<RadzenPassword @bind-Value="model.NewPassword" Name="NewPassword" Placeholder="New Password" Style="width: 100%" />
			<RadzenPassword @bind-Value="model.ConfirmPassword" Name="ConfirmPassword" Placeholder="Comfirm Password" Style="width: 100%" />

			@if (!string.IsNullOrEmpty(errorMessage))
			{
				<div class="error-text">@errorMessage</div>
			}
			<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem">
				<RadzenButton Text="Cancel" Click="@Cancel" ButtonStyle="ButtonStyle.Secondary" />
				<RadzenButton Text="Submit" ButtonType="ButtonType.Submit" class="btn-lunar" />
			</RadzenStack>

		</RadzenStack>
	</RadzenTemplateForm>
</RadzenCard>

@code {
	[Parameter] public string Username { get; set; } = string.Empty;
	[Parameter] public int UserId { get; set; }

	private PasswordModel model = new();
	private string errorMessage = string.Empty;
	protected override void OnInitialized()
	{
		Console.WriteLine("Loaded");
		base.OnInitialized();
	}
	private async Task Submit()
	{
		errorMessage = string.Empty;

		if(string.IsNullOrWhiteSpace(model.OldPassword) ||
					string.IsNullOrWhiteSpace(model.NewPassword) ||
					string.IsNullOrWhiteSpace(model.ConfirmPassword))
		{
			errorMessage = "All fields are required";
			return;
		}

		if (model.NewPassword != model.ConfirmPassword)
		{
			errorMessage = "The new passwords must match";
			return;
		}
		var client = httpClientFactory.CreateClient("ServerAPI");

		var loginDto = new LoginDto
			{
				Username = Username,
				Password = model.OldPassword
			};
		var loginResponse = await client.PostAsJsonAsync("/api/auth/login", loginDto);

		if (!loginResponse.IsSuccessStatusCode)
		{
			errorMessage = "Old password is incorrect";
			return;
		}
		var updateDto = new PasswordDto { Password = model.NewPassword };

		var updateResponse = await client.PutAsJsonAsync($"api/users/{UserId}/password", updateDto);

		if (updateResponse.IsSuccessStatusCode)
		{
			DialogService.Close(true);
		}
		else
		{
			errorMessage = "Failed to update password";
		}

	}

	private void Cancel() => DialogService.Close(false);

	public class PasswordModel
	{
		public string OldPassword { get; set; } = string.Empty;
		public string NewPassword { get; set; } = string.Empty;
		public string ConfirmPassword { get; set; } = string.Empty;
	}
}