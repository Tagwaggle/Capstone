@page "/contact"
@layout MainLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using LanceMudCapstone.Models

@inject IHttpClientFactory ClientFactory
<div class="login-wrapper">
<div class="contact-container">
    <h2 class="contact-title">Contact Us</h2>


    <div class="form-group">
        <label>Name</label>
        <InputText @bind-Value="form.Name" class="form-control" />

    </div>

    <div class="form-group">
        <label>Email</label>
        <InputText @bind-Value="form.Email" class="form-control" />

    </div>

    <div class="form-group">
        <label>Message</label>
        <InputTextArea @bind-Value="form.Message" class="form-control message-box" />

    </div>

    <button @onclick="SendContact" class="submit-button">Send Message</button>

    @if (Success)
    {
        <p class="success-message">@messageSuccess</p>
    }

    @if (Error)
    {
        <ul class="error-message">
            @foreach (var err in ValidationError)
            {
                <li>@err</li>
            }
        </ul>
    }
</div>
</div>

@code {
    ContactFormModel form = new();
    bool Success = false;
    bool Error = false;

    string messageSuccess = string.Empty;
    List<string> ValidationError = new();



    private async Task SendContact()
    {
        Success = false;
        Error = false;
        ValidationError.Clear();
        messageSuccess = string.Empty;



        if (string.IsNullOrEmpty(form.Name)) ValidationError.Add("Name is required.");
        if (string.IsNullOrEmpty(form.Email)) ValidationError.Add("Email is required.");
        if (string.IsNullOrEmpty(form.Message)) ValidationError.Add("Message is required.");


        if (ValidationError.Any())
        {
            Error = true;
            return;
        }

        try
        {
            var client = ClientFactory.CreateClient("ServerAPI");
            var response = await client.PostAsJsonAsync("/api/contact", form);

            Console.WriteLine($"Response status: {response.StatusCode}");
            var content = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Response body: {content}");
            Success = true;
            messageSuccess = "Message Sent Successfuly";
        }
        catch
        {
            Error = true;
            ValidationError.Add("Something went wrong.");
            return;
        }
    }
}
