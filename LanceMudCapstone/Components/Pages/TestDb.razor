@page "/test-admin"
@inject UserService Users
@rendermode InteractiveServer


<h3>Admin Insert Test</h3>

<button @onclick="InsertAdmin">Insert Admin User</button>

@if (!string.IsNullOrEmpty(Message))
{
    <p>@Message</p>
}

@code {
    private string Message = "";

    private async Task InsertAdmin()
    {
        var admin = new User
        {
            Username = "admin",
            Email = "admin@example.com",
            PasswordHash = PasswordHelper.HashPassword("admin123"), // replace with hashed later
            IsActive = true
        };

        try
        {
            var id = await Users.AddUserAsync(admin);
            Message = $"Admin user created with ID: {id}";
        }
        catch (Exception ex)
        {
            Message = $"Error: {ex.Message}";
        }
    }
}
