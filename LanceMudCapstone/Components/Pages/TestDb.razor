@page "/test-db"
@rendermode InteractiveServer
@inject IHttpClientFactory ClientFactory

<h3>Database Connectivity Test</h3>

<button @onclick="TestConnection">Test DB Connection</button>
<button @onclick="TestBobLogin">Test Login (bob/bob)</button>

@if (!string.IsNullOrEmpty(TestResult))
{
    <p>Result: @TestResult</p>
}

<p>@Result</p>

@code {
    private string Result = "";

    private async Task TestConnection()
    {
        try
        {
            var client = ClientFactory.CreateClient("ServerAPI");

            var response1 = await client.GetAsync("api/test-db");
            var text1 = await response1.Content.ReadAsStringAsync();

            var response2 = await client.GetAsync("api/test-db-users");
            var text2 = await response2.Content.ReadAsStringAsync();

            Result = $"Test DB:\n{text1}\n\nTest DB Users:\n{text2}";
        }
        catch (Exception ex)
        {
            Result = $"Error: {ex.Message}";
        }
    }
    private string? TestResult;

    private async Task TestBobLogin()
    {
        var dto = new LoginDto
        {
            Username = "bob",
            Password = "bob"
        };

        var client = ClientFactory.CreateClient("ServerAPI");

        Console.WriteLine("=== Manual Test Login (bob/bob) ===");
        Console.WriteLine($"Sending DTO: username={dto.Username}, password={dto.Password}");

        var response = await client.PostAsJsonAsync("/api/auth/login", dto);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadFromJsonAsync<ApiErrorDto>();
            TestResult = $"FAIL: {error?.Message}";
            Console.WriteLine($"FAIL: {error?.Message}");
            return;
        }

        var user = await response.Content.ReadFromJsonAsync<UserDto>();
        TestResult = $"SUCCESS: Logged in as {user?.Username}";
        Console.WriteLine($"SUCCESS: Logged in as {user?.Username}");
    }

}
