@page "/play"
@layout PlayLayout
@inject SessionState SessionState
@implements IDisposable

<RadzenSplitter Orientation="Orientation.Horizontal"
                Style="width: 100%; height: calc(100vh - 6.5rem);">
    @if(SessionState.ShowLeftPanel)
    {
    <RadzenSplitterPane Size="20%" Min="150px" Style="align-content: center; justify-items: center;">
        <NavComp />
    </RadzenSplitterPane>
    }
    <RadzenSplitterPane Size="60%" Style="justify-items: center;">
        <Play />
    </RadzenSplitterPane>
    @if (SessionState.ShowRightPanel)
    {
        <RadzenSplitterPane Size="25%" Min="150px" Style="overflow: hidden; padding-top: 5.5rem">
            <RadzenTabs Style="height: 100%; display: flex; flex-direction: column;">
                <Tabs>
                    <RadzenTabsItem Text="Commands">
                    <ComComp />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Chat">
                        <ChatComp />
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenSplitterPane>
    }
</RadzenSplitter>

@code{
    private Func<Task> _stateHandler = default;

    protected override void OnInitialized()
    {
        _stateHandler = () => InvokeAsync(StateHasChanged);
        SessionState.OnChange += _stateHandler;
        base.OnInitialized();
    }
    public void Dispose()
    {
        SessionState.OnChange -= _stateHandler;
    }
}