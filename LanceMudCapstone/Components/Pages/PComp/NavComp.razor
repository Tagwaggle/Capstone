@inject SessionState SessionState
@inject CharacterService CharacterService
@inject MudHubClient HubClient

@implements IDisposable

<div class="play-movement">
    <h3>Movement</h3>

    <div class="compass-rose">
        <div></div>

        <div class="cell">
            <button @onclick='() => Move("north")'
                    disabled="@(!HasExit("north"))"
                    class="@(!HasExit("north") ? "disabled-btn" : null)">
                N
            </button>
        </div>

        <div class="cell">
            <button @onclick='() => Move("up")'
                    disabled="@(!HasExit("up"))"
                    class="@(!HasExit("up") ? "disabled-btn" : null)">
                U
            </button>
        </div>

        <div class="cell">
            <button @onclick='() => Move("west")'
                    disabled="@(!HasExit("west"))"
                    class="@(!HasExit("west") ? "disabled-btn" : null)">
                W
            </button>
        </div>

        <div></div>

        <div class="cell">
            <button @onclick='() => Move("east")'
                    disabled="@(!HasExit("east"))"
                    class="@(!HasExit("east") ? "disabled-btn" : null)">
                E
            </button>
        </div>

        <div></div>

        <div class="cell">
            <button @onclick='() => Move("south")'
                    disabled="@(!HasExit("south"))"
                    class="@(!HasExit("south") ? "disabled-btn" : null)">
                S
            </button>
        </div>

        <div class="cell">
            <button @onclick='() => Move("down")'
                    disabled="@(!HasExit("down"))"
                    class="@(!HasExit("down") ? "disabled-btn" : null)">
                D
            </button>
        </div>
    </div>
</div>

@code{
    private bool HasExit(string dir)
    => SessionState.CurrentRoomExits?
        .Any(e => e.Direction.Equals(dir, StringComparison.OrdinalIgnoreCase)) == true;

    private async Task Move(string dir)
    {
        int? oldRoomId = SessionState.RoomId;

        if (SessionState.RoomId.HasValue)
            await HubClient.LeaveRoom(SessionState.RoomId.Value);
        await CharacterService.UpdateLastCommand(SessionState.CharacterId!.Value);
        await SessionState.TryMoveAsync(dir);
        string dirLeave = string.Empty;
        switch(dir){
            case "up":
                dirLeave = "down below";
                break;
            case "down":
                dirLeave = "up above";
                break;
            case "east":
                dirLeave = "the west";
                break;
            case "west":
                dirLeave = "the east";
                break;
            case "south":
                dirLeave = "the north";
                break;
            case "north":
                dirLeave = "the south";
                break;
            default:
                dirLeave = "somewhere";
                break;
        }
        await HubClient.AnnounceToRoom(oldRoomId!.Value, $"{SessionState.Pfile?.Name} leaves {dir}.");

        await HubClient.AnnounceToRoom(SessionState.RoomId!.Value, $"{SessionState.Pfile?.Name} has entered from {dirLeave}.");

        if (SessionState.RoomId.HasValue)
            await HubClient.JoinRoom(SessionState.RoomId.Value);
    }
    private Func<Task> _stateHandler = default!;

    protected override void OnInitialized()
    {
        _stateHandler = () => InvokeAsync(StateHasChanged);
        SessionState.OnChange += _stateHandler;
    }

    public void Dispose()
    {
        SessionState.OnChange -= _stateHandler;
    }
}