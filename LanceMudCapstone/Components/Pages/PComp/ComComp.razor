@inject SessionState SessionState
@inject CharacterService CharacterService
@inject NavigationManager Nav
@inject NotificationService NotificationService
@inject ContainerService ContainerService
@implements IDisposable


        <h3>Commands</h3>
        <div>
        @foreach (var c in SessionState.CurrentRoomContainers)
            {
                <button @onclick="() => GetLoot(c.ContainerId)">
                    Loot @c.Name
                </button>
            }

            @foreach (var mob in SessionState.CurrentRoomMobs)
            {
                if (!nonAttackable.Contains(mob.Base.CharacterType))
                {
                    <button @onclick="() => Attack(mob.Instance.NpcId)">
                        Attack @mob.Base.Name
                    </button>
                }
            }

            <button @onclick="() => showScoreModal = true">Score</button>
            <button @onclick="() => showInventoryModal = true">Inventory</button>
            <button @onclick="() => showSpellBook = true">Spells / Skills</button>
            <button @onclick="ChangeCharacter">Logout</button>
            <button @onclick="SaveButton_Clicked">Save Character</button>
        </div>

@if (showSpellBook)
    {
        <SpellbookModal Show="@showSpellBook"
                        ShowChanged="v => showSpellBook = v"
                        Player="@SessionState.Pfile" />
    }

    <InventoryModal Show="@showInventoryModal"
                    ShowChanged="v => showInventoryModal = v" />

    <PlayScore Show="@showScoreModal"
               ShowChanged="v => showScoreModal = v" />



@code {
    private readonly string[] nonAttackable = { "shop", "guard", "safe", "pc" };

    private bool showSpellBook;
    private bool showScoreModal;
    private bool showInventoryModal;


    private async Task GetLoot(int containerId)
    {

        var lootedItems = await ContainerService.GetLootAsync(SessionState.Pfile.PlayerCharacterId!.Value, containerId);
        await CharacterService.UpdateLastCommand(SessionState.CharacterId!.Value);

        if (lootedItems.Any())
        {
            string lootItems = "You looted: \n";
            foreach (var item in lootedItems)
            {
                await SessionState.PushEvent($"You loot {string.Join(", ", lootedItems.Select(i => i.Name))} from the container.");
                lootItems += item.Name + " ";
            }
            lootItems += '\n';
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Loot",
                Detail = $"{lootItems}",
                Duration = 2000
            });
        }
        else
        {
            await SessionState.PushEvent("Nothing there but cobwebs and entrails.");
        }
        SessionState.CurrentRoomContainers =
            SessionState.CurrentRoomContainers
                .Where(c => c.ContainerId != containerId)
                .ToList();

        await SessionState.NotifyStateChange();
        await InvokeAsync(StateHasChanged);
    }
    private async Task SaveButton_Clicked()
    {
        if (SessionState.Pfile == null) return;
        await CharacterService.SavePlayer(SessionState.Pfile);
        NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Saved",
                Detail = $"Character: {SessionState.Pfile.Name} Successful",
                Duration = 2000
            });
        await SessionState.NotifyStateChange();

    }
    private async Task Attack(int id)
    {
        var mob = SessionState.CurrentRoomMobs.First(m => m.Instance.NpcId == id);
        await CharacterService.UpdateLastCommand(SessionState.CharacterId!.Value);

        await SessionState.RefreshCharacterAsync();

        if (mob == null) return;

        SessionState.CurrentMob = new PlayerCharacterDto
        {
            CharacterId = mob.Base.CharacterId,
            NpcId = mob.Instance.NpcId,
            CharacterType = mob.Base.CharacterType,

            Name = mob.Base.Name,
            Health = mob.Base.MaxHealth,
            MaxHealth = mob.Base.MaxHealth,
            Level = mob.Base.Level,
            Strength = mob.Base.Strength,
            Dexterity = mob.Base.Dexterity,
            Constitution = mob.Base.Constitution,
            Intelligence = mob.Base.Intelligence,
            Wisdom = mob.Base.Wisdom,
            Charisma = mob.Base.Charisma,
            ArmorClass = mob.Base.ArmorClass,
            IsAlive = mob.Base.Health > 0
        };

        await SessionState.SetCombat(true);
        //StartCombat(player, currentMob);
        await SessionState.NotifyStateChange();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ChangeCharacter()
    {
        await SessionState.ClearCharacterAsync();
        await SessionState.InitializeAsync();
        await SessionState.SetUserAsync(SessionState.UserId ?? 0, SessionState.UserName ?? "", SessionState.UserIcon);
        Nav.NavigateTo("/character");
    }

    private Func<Task> _stateHandler = default!;

    protected override void OnInitialized()
    {
        _stateHandler = () => InvokeAsync(StateHasChanged);
        SessionState.OnChange += _stateHandler;
    }

    public void Dispose()
    {
        SessionState.OnChange -= _stateHandler;
    }
}
