@page "/GameLayout"
@using System.Text
@using LanceMudCapstone.Models
@using LanceMudCapstone.DTOs
@using LanceMudCapstone.Services

@inject SessionState SessionState
@inject CharacterService CharacterService
@inject NavigationManager Nav

@layout PlayLayout
@rendermode InteractiveServer

<div class="play-screen">
    <div class="play-movement">
        <h3>Movement</h3>
        <div class="compass-rose">
            <div></div>

            <div class="cell">
                @if (HasExit("north"))
                {
                    <button @onclick='() => Move("north")'>N</button>
                }
                else
                {
                    <button disabled class="disabled-btn">N</button>
                }
            </div>

            <div class="cell">
                @if (HasExit("up"))
                {
                    <button @onclick='() => Move("up")'>U</button>
                }
                else
                {
                    <button disabled class="disabled-btn">U</button>
                }
            </div>

            <div class="cell">
                @if (HasExit("west"))
                {
                    <button @onclick='() => Move("west")'>W</button>
                }
                else
                {
                    <button disabled class="disabled-btn">W</button>
                }
            </div>

            <div></div>

            <div class="cell">
                @if (HasExit("east"))
                {
                    <button @onclick='() => Move("east")'>E</button>
                }
                else
                {
                    <button disabled class="disabled-btn">E</button>
                }
            </div>

            <div></div>

            <div class="cell">
                @if (HasExit("south"))
                {
                    <button @onclick='() => Move("south")'>S</button>
                }
                else
                {
                    <button disabled class="disabled-btn">S</button>
                }
            </div>

            <div class="cell">
                @if (HasExit("down"))
                {
                    <button @onclick='() => Move("down")'>D</button>
                }
                else
                {
                    <button disabled class="disabled-btn">D</button>
                }
            </div>
        </div>
    </div>
    <div class="play-main">
        <div class="ascii-monitor">
            <pre>
@BuildAsciiMonitor(SessionState.CurrentRoom,
                                      SessionState.CurrentRoomMobs,
                                      SessionState.CurrentRoomContainers,
                                      SessionState.CurrentRoomExits)
            </pre>
        </div>
    </div>

<div class="play-sidebar">
    <h3>Commands</h3>

        
    <button @onclick="GetLoot">Get Loot</button>
    @foreach (var child in SessionState.CurrentRoomMobs)
    {
        if(!nonAttackable.Contains(child.Base.CharacterType))
        {
        <button @onclick="() => Attack(child.Instance.NpcId)">Attack @child.Base.Name </button>
        }
    }
    <button @onclick="() => showScoreModal = true">Score</button>
    <button @onclick="() => showInventoryModal = true">Inventory</button>
    <button @onclick="ShowSpells">Spells/Skills</button>
    <button @onclick="ChangeCharacter">Switch Character</button>
</div>


    </div>


<InventoryModal Show="@showInventoryModal"
                ShowChanged="v => showInventoryModal = v" />
<PlayScore Show="@showScoreModal" ShowChanged="v => showScoreModal = v" />


@code {
    private bool showScoreModal = false;
    private bool showInventoryModal = false;
    private string[] nonAttackable = new[] { "shop", "guard", "safe", "pc" };

 
    public static string BuildAsciiMonitor(Room? room,
                                           IEnumerable<RoomNpcDto> mobs,
                                           IEnumerable<Container> containers,
                                            IEnumerable<RoomExit> roomExits)
    {
        var lines = new List<string>();

        if (room != null)
        {
            lines.Add(room.Name ?? "");
            foreach (var wrappedLine in RoomService.WordWrap(room.Description ?? "", 40))
            {
                lines.Add(wrappedLine);                
            }
        }

        if (mobs?.Any() == true)
        {
            lines.Add("Mob:");
            foreach (var m in mobs)
            {
                lines.Add("    " + m.Base.Name);
            }
        }

        if (containers?.Any() == true)
        {
            lines.Add("Container:");
            foreach (var c in containers)
            {
                lines.Add("    " + c.Name);
            }
        }
        if (roomExits?.Any() == true)
        {
            lines.Add("Exits:");
            foreach (var e in roomExits)
            {
                lines.Add("    " + e.Direction);
            }
        }
        else
        {
            lines.Add("Exits:");
            lines.Add("YOU'RE TRAPPED");
        }

        lines.Add(">"); // prompt line

        int maxWidth = lines.Any() ? lines.Max(l => l.Length) : 1;

        var sb = new StringBuilder();
        sb.AppendLine("|" + new string('=', maxWidth + 2) + "|");

        foreach (var line in lines)
        {
            string padded = line.PadRight(maxWidth, ' ');
            sb.AppendLine($"| {padded} |");
        }

        sb.AppendLine("|" + new string('=', maxWidth + 2) + "|");

        return sb.ToString();
    }

    private void GetLoot() => Console.WriteLine("Get Loot triggered");
    private void Attack(int id) => Console.WriteLine($"Attack triggered {id}");
    private void ShowSpells() => Console.WriteLine("Spells triggered");

    async private Task ChangeCharacter()
    {
        if (SessionState.Pfile == null)
        {
            Nav.NavigateTo("/character", true);
            return;
        }

        await CharacterService.SavePlayer(SessionState.Pfile);

        await SessionState.ClearCharacterAsync(); // we’ll add this
        Nav.NavigateTo("/character", true);
    }


    private bool HasExit(string dir) => SessionState.CurrentRoomExits?.Any(e => e.Direction.Equals(dir, StringComparison.OrdinalIgnoreCase)) == true;

    private async Task Move(string dir)
    {
        await SessionState.TryMoveAsync(dir);
    }
}
