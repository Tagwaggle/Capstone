
@using System.Text
@using LanceMudCapstone.Models
@using LanceMudCapstone.DTOs
@using LanceMudCapstone.Services

@inject SessionState SessionState
@inject CharacterService CharacterService
@inject NavigationManager Nav
@inject ContainerService ContainerService
@implements IDisposable

@if (!_loaded)
{
    <p>Entering the world…</p>
}
else
{
    <div class="login-wrapper">
            <div class="play-main">
            <div class="ascii-monitor">
                <pre>
    @BuildAsciiMonitor(
        SessionState.CurrentRoom,
        SessionState.CurrentRoomMobs,
        SessionState.CurrentRoomPcs,
        SessionState.CurrentRoomContainers,
        SessionState.CurrentRoomExits,
        SessionState.EventLog)
                </pre>
        </div>
    </div>
    @if (SessionState.InCombat)
        {
            <div class="combat-slide">
                <CombatScreen Player="@SessionState.Pfile"
                              Mob="@SessionState.CurrentMob"
                              OnVictory="HandleVictory"
                              OnDefeat="HandleDefeat" />
            </div>
        }
    </div>
}
@code {
    private bool _loaded;
    private bool _loadInProgress;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCts;


    private bool showSpellBook;
    private bool showScoreModal;
    private bool showInventoryModal;


    private PlayerCharacterDto currentMob;


/*    protected override async Task OnInitializedAsync()
    {
        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));

        _ = RunRefreshLoop(_refreshCts.Token);

    }
        */
    private async Task RunRefreshLoop(CancellationToken token)
    {
        Console.WriteLine($"Character Session trying tick {SessionState.CharacterId}");
        try
        {
            while (await _refreshTimer!.WaitForNextTickAsync(token))
            {
                if (SessionState.Ready && SessionState.CharacterId != null)
                {
                    Console.WriteLine($"Prior Health: {SessionState.Pfile.Health} Character Session tick");
                    await SessionState.RefreshCharacterAsync();
                    Console.WriteLine($"Post Health: {SessionState.Pfile.Health} Success Async");
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Timer was stopped, exit gracefully
        }
    }




    protected override void OnInitialized()
    {
        SessionState.OnChange += () => InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        await TryInitializePlayAsync();
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await TryInitializePlayAsync();
            StateHasChanged();
        });
    }

    private async Task TryInitializePlayAsync()
    {
        if (_loaded || _loadInProgress)
            return;

        if (!SessionState.IsLoggedIn)
            return;

        if (!SessionState.CharacterReady)
            return;

        _loadInProgress = true;

        if (SessionState.CurrentRoom == null)
            await SessionState.MoveToRoom(2);

        if (SessionState.CurrentRoom == null)
            return;

        _loaded = true;
        _loadInProgress = false;

        StateHasChanged();
    }

    public static string BuildAsciiMonitor(
        Room? room,
        IEnumerable<RoomNpcDto> mobs,
		IEnumerable<RoomPcDto> pcs,
        IEnumerable<Container> containers,
        IEnumerable<RoomExit> exits,
        IEnumerable<string> eventLog)
    {
        var lines = new List<string>();

        if (eventLog.Any())
        {
//            Console.WriteLine("eventLog Triggered:");
            int totalCount = eventLog.Count();
            if (totalCount > 5)
            {
  //              Console.WriteLine($"Max line reach {totalCount}");
                lines.Add($"Showing {Math.Min(5, totalCount)} of {totalCount} recent events:");
                eventLog = eventLog.TakeLast(5);
            }
            else
            {
                lines.Add("Recent events:");
            }
            foreach (var e in eventLog)
                lines.Add("    " + e);

        }
        else
        {
            Console.WriteLine("eventLog skipped");
        }
        if (room != null)
        {
            lines.Add(room.Name ?? "");
            foreach (var l in RoomService.WordWrap(room.Description ?? "", 40))
                lines.Add(l);
        }

        if (mobs.Any())
        {
            lines.Add("Mob:");
            foreach (var m in mobs)
                lines.Add("    " + m.Base.Name);
        }
        if (pcs.Any())
        {
            lines.Add("Player:");
            foreach (var p in pcs)
                lines.Add("    " + p.Base.Name);
		}
        if (containers.Any())
        {
            lines.Add("Container:");
            foreach (var c in containers)
                lines.Add("    " + c.Name);
        }

        if (exits.Any())
        {
            lines.Add("Exits:");
            foreach (var e in exits)
                lines.Add("    " + e.Direction);
        }
        else
        {
            lines.Add("Exits:");
            lines.Add("YOU'RE TRAPPED");
        }

        lines.Add(">");

        int max = lines.Max(l => l.Length);
        var sb = new StringBuilder();

        sb.AppendLine("|" + new string('=', max + 2) + "|");
        foreach (var l in lines)
            sb.AppendLine($"| {l.PadRight(max)} |");
        sb.AppendLine("|" + new string('=', max + 2) + "|");

        return sb.ToString();
    }

    private async Task HandleVictory(string mobName)
    {
        await SessionState.SetCombat(false);
        await RefreshAfterCombat();
        //        showCombat = false;
    }

    private async Task HandleDefeat()
    {
        await SessionState.SetCombat(false);
        await RefreshAfterCombat();
        //        showCombat = false;
    }
    private async Task RefreshAfterCombat()
    {
        await SessionState.MoveToRoom(SessionState.CurrentRoom.RoomId);
        await SessionState.NotifyStateChange();
    }

    private Func<Task> _stateHandler = default!;

    protected override async Task OnInitializedAsync()
    {
        _stateHandler = async () =>
        {
            await TryInitializePlayAsync();
            await InvokeAsync(StateHasChanged);
        };
        SessionState.OnChange += _stateHandler;

        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RunRefreshLoop(_refreshCts.Token);
    }

    public void Dispose()
    {
        SessionState.OnChange -= _stateHandler;
        _refreshCts?.Cancel();
        _refreshTimer?.Dispose();
        _refreshCts?.Dispose();
    }
}
