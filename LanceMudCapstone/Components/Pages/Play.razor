@page "/play"
@rendermode InteractiveServer
@layout PlayLayout

@using System.Text
@using LanceMudCapstone.Models
@using LanceMudCapstone.DTOs
@using LanceMudCapstone.Services

@inject SessionState SessionState
@inject CharacterService CharacterService
@inject NavigationManager Nav
@inject ContainerService ContainerService;

@if (!_loaded)
{
    <p>Entering the world…</p>
}
else
{
    <div class="play-screen">
        <div class="play-movement">
            <h3>Movement</h3>

            <div class="compass-rose">
                <div></div>

                <div class="cell">
                    <button @onclick='() => Move("north")'
                            disabled="@(!HasExit("north"))"
                            class="@(!HasExit("north") ? "disabled-btn" : null)">
                        N
                    </button>
                </div>

                <div class="cell">
                    <button @onclick='() => Move("up")'
                            disabled="@(!HasExit("up"))"
                            class="@(!HasExit("up") ? "disabled-btn" : null)">
                        U
                    </button>
                </div>

                <div class="cell">
                    <button @onclick='() => Move("west")'
                            disabled="@(!HasExit("west"))"
                            class="@(!HasExit("west") ? "disabled-btn" : null)">
                        W
                    </button>
                </div>

                <div></div>

                <div class="cell">
                    <button @onclick='() => Move("east")'
                            disabled="@(!HasExit("east"))"
                            class="@(!HasExit("east") ? "disabled-btn" : null)">
                        E
                    </button>
                </div>

                <div></div>

                <div class="cell">
                    <button @onclick='() => Move("south")'
                            disabled="@(!HasExit("south"))"
                            class="@(!HasExit("south") ? "disabled-btn" : null)">
                        S
                    </button>
                </div>

                <div class="cell">
                    <button @onclick='() => Move("down")'
                            disabled="@(!HasExit("down"))"
                            class="@(!HasExit("down") ? "disabled-btn" : null)">
                        D
                    </button>
                </div>
            </div>
        </div>

        <div class="play-main">
            <div class="ascii-monitor">
                <pre>
    @BuildAsciiMonitor(
        SessionState.CurrentRoom,
        SessionState.CurrentRoomMobs,
        SessionState.CurrentRoomContainers,
        SessionState.CurrentRoomExits)
                </pre>
        </div>
    </div>

    <div class="play-sidebar">
        <h3>Commands</h3>

        <button @onclick="GetLoot">Get Loot</button>

        @foreach (var mob in SessionState.CurrentRoomMobs)
            {
                if (!nonAttackable.Contains(mob.Base.CharacterType))
                {
                    <button @onclick="() => Attack(mob.Instance.NpcId)">
                        Attack @mob.Base.Name
                    </button>
                }
            }

            <button @onclick="() => showScoreModal = true">Score</button>
            <button @onclick="() => showInventoryModal = true">Inventory</button>
            <button @onclick="() => showSpellBook = true">Spells / Skills</button>
            <button @onclick="ChangeCharacter">Logout</button>
        </div>
    </div>
    @if (showCombat)
    {
        <div class="combat-slide">
            <CombatScreen Player="@player"
                          Mob="@currentMob"
                          OnVictory="HandleVictory"
                          OnDefeat="HandleDefeat" />
        </div>
    }
    @if (showSpellBook)
    {
        <SpellbookModal Show="@showSpellBook"
                        ShowChanged="v => showSpellBook = v"
                        Player="@player" />
    }

    <InventoryModal Show="@showInventoryModal"
                    ShowChanged="v => showInventoryModal = v" />

    <PlayScore Show="@showScoreModal"
               ShowChanged="v => showScoreModal = v" />
}

@code {
    private bool _loaded;
    private bool _loadInProgress;

    private bool showSpellBook;
    private bool showScoreModal;
    private bool showInventoryModal;
    private bool showCombat = false;

    private PlayerCharacterDto player;
    private PlayerCharacterDto currentMob;

    private readonly string[] nonAttackable = { "shop", "guard", "safe", "pc" };

    private void StartCombat(PlayerCharacterDto mob)
    {
        currentMob = mob;
        Console.WriteLine($"[StartCombat]:{currentMob.Name} is being attacked");
        Console.WriteLine($"[ShowCombat]:{showCombat} before");
        showCombat = true;
        Console.WriteLine($"[ShowCombat]:{showCombat} after");
    }

    private async Task HandleVictory(string mobName)
    {
        showCombat = false;
        // dont forget to show all the fun stuff you won from the mob and remove it from the room
    }

    private async Task HandleDefeat()
    {
        showCombat = false;
        // bounce to character room 2 with a "you died" message
    }

    protected override void OnInitialized()
    {
        SessionState.OnChange += HandleSessionChanged;
        player = SessionState.Pfile;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        await TryInitializePlayAsync();
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await TryInitializePlayAsync();
            StateHasChanged();
        });
    }

    private async Task TryInitializePlayAsync()
    {
        if (_loaded || _loadInProgress)
            return;

        // Wait for session hydration
        if (!SessionState.IsLoggedIn)
            return;

        // Logged in but no character = bounce
        if (!SessionState.CharacterReady)
        {
            //            Nav.NavigateTo("/character", true);
            return;
        }

        _loadInProgress = true;

        // Refresh-safe: room may be missing
        if (SessionState.CurrentRoom == null)
        {
            await SessionState.MoveToRoom(2);
        }

        // Still missing = invalid state
        if (SessionState.CurrentRoom == null)
        {
            //          Nav.NavigateTo("/character", true);
            return;
        }

        _loaded = true;
        _loadInProgress = false;

        StateHasChanged();
    }

    public void Dispose()
    {
        SessionState.OnChange -= HandleSessionChanged;
    }

    private bool HasExit(string dir)
        => SessionState.CurrentRoomExits?
            .Any(e => e.Direction.Equals(dir, StringComparison.OrdinalIgnoreCase)) == true;

    private async Task Move(string dir)
        => await SessionState.TryMoveAsync(dir);

    private void GetLoot()
    {
        var container = SessionState.CurrentRoomContainers?.FirstOrDefault();

        if (container == null)
        { // add too display
            return;
        }

        var items = ContainerService.GetLootAsync(SessionState.Pfile.PlayerCharacterId, container.ContainerId);

        SessionState.CurrentRoomContainers = SessionState.CurrentRoomContainers
                    .Where(c => c.ContainerId != container.ContainerId).ToList();
    }

    private async void Attack(int id)
    {
        var mob = SessionState.CurrentRoomMobs.First(m => m.Instance.NpcId == id);

        if (mob == null) return;

        currentMob = new PlayerCharacterDto
        {
            Name = mob.Base.Name,
            Health = mob.Base.Health,
            MaxHealth = mob.Base.MaxHealth,
            Level = mob.Base.Level,
            Strength = mob.Base.Strength,
            Dexterity = mob.Base.Dexterity,
            ArmorClass = mob.Base.ArmorClass,
            Intelligence = mob.Base.Intelligence,
            IsAlive = mob.Base.Health > 0
        };
        Console.WriteLine($"[Attack:]{currentMob.Name} is being attacked");
        StartCombat(currentMob);

        await InvokeAsync(StateHasChanged);
    }

    private void ShowSpells()
        => Console.WriteLine("Spells triggered");

    private async Task ChangeCharacter()
    {
        await SessionState.ClearCharacterAsync();
        Nav.NavigateTo("/character", true);
    }

    public static string BuildAsciiMonitor(
        Room? room,
        IEnumerable<RoomNpcDto> mobs,
        IEnumerable<Container> containers,
        IEnumerable<RoomExit> exits)
    {
        var lines = new List<string>();

        if (room != null)
        {
            lines.Add(room.Name ?? "");
            foreach (var l in RoomService.WordWrap(room.Description ?? "", 40))
                lines.Add(l);
        }

        if (mobs.Any())
        {
            lines.Add("Mob:");
            foreach (var m in mobs)
                lines.Add("    " + m.Base.Name);
        }

        if (containers.Any())
        {
            lines.Add("Container:");
            foreach (var c in containers)
                lines.Add("    " + c.Name);
        }

        if (exits.Any())
        {
            lines.Add("Exits:");
            foreach (var e in exits)
                lines.Add("    " + e.Direction);
        }
        else
        {
            lines.Add("Exits:");
            lines.Add("YOU'RE TRAPPED");
        }

        lines.Add(">");

        int max = lines.Max(l => l.Length);
        var sb = new StringBuilder();

        sb.AppendLine("|" + new string('=', max + 2) + "|");
        foreach (var l in lines)
            sb.AppendLine($"| {l.PadRight(max)} |");
        sb.AppendLine("|" + new string('=', max + 2) + "|");

        return sb.ToString();
    }
}
