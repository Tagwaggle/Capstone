@page "/play/score"
@rendermode InteractiveServer
@layout PlayLayout

@inject SessionState SessionState

<div class="score-container">
    <h2>Score for @SessionState.Pfile?.Name</h2>

    @if (SessionState.Pfile == null)
    {
        <p>No character loaded. Please login first.</p>
    }
    else
    {
        <table class="score-table">
            <tr><th>Level</th><td>@SessionState.Pfile.Level</td></tr>
            <tr><th>Class</th><td>@SessionState.Pfile.Class</td></tr>
            <tr><th>Race</th><td>@SessionState.Pfile.Race</td></tr>
            <tr><th>Alignment</th><td>@SessionState.Pfile.Alignment</td></tr>
            <tr><th>HP</th><td>@SessionState.Pfile.Health / @SessionState.Pfile.MaxHealth</td></tr>
            <tr><th>Armor Class</th><td>@SessionState.Pfile.ArmorClass</td></tr>
            <tr><th>Strength</th><td>@SessionState.Pfile.Strength</td></tr>
            <tr><th>Dexterity</th><td>@SessionState.Pfile.Dexterity</td></tr>
            <tr><th>Constitution</th><td>@SessionState.Pfile.Constitution</td></tr>
            <tr><th>Intelligence</th><td>@SessionState.Pfile.Intelligence</td></tr>
            <tr><th>Wisdom</th><td>@SessionState.Pfile.Wisdom</td></tr>
            <tr><th>Charisma</th><td>@SessionState.Pfile.Charisma</td></tr>
            <tr><th>Gold</th><td>@SessionState.Pfile.Gold</td></tr>
            <tr><th>Active Quest</th><td>@(SessionState.Pfile.ActiveQuest?.ToString() ?? "None")</td></tr>
            <tr><th>Last Online</th><td>@(SessionState.Pfile.LastOnline?.ToString("g") ?? "Never")</td></tr>
            <tr><th>Created At</th><td>@SessionState.Pfile.CreatedAt.ToString("g")</td></tr>
        </table>
    }
</div>

<style>
    .score-container {
        margin: 2rem;
        padding: 1rem;
        background: #111;
        color: #eee;
        border: 2px solid #444;
        border-radius: 8px;
    }

    .score-table {
        width: 100%;
        border-collapse: collapse;
    }

        .score-table th {
            text-align: left;
            padding: 4px 8px;
            background: #222;
            width: 150px;
        }

        .score-table td {
            padding: 4px 8px;
            background: #1a1a1a;
        }
</style>
