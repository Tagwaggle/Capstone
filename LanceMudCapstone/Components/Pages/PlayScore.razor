@inject SessionState SessionState
@rendermode InteractiveServer

@if (Show)
{
    <div class="modal-backdrop" @onclick="Close"></div>

    <div class="modal-window">
        <h2>Score for @SessionState.Pfile?.Name</h2>

        @if (SessionState.Pfile == null)
        {
            <p>No character loaded.</p>
        }
        else
        {
            <table class="score-table spaced">
                <tr>
                    <th>Level</th>
                    <td>@SessionState.Pfile.Level</td>
                    <th>Class</th>
                    <td>@SessionState.Pfile.Class</td>
                </tr>

                <tr>
                    <th>Race</th>
                    <td>@SessionState.Pfile.Race</td>
                    <th>Alignment</th>
                    <td>@SessionState.Pfile.Alignment</td>
                </tr>

                <tr>
                    <th>HP</th>
                    <td>@SessionState.Pfile.Health / @SessionState.Pfile.MaxHealth</td>
                    <th>Armor Class</th>
                    <td>@SessionState.Pfile.ArmorClass</td>
                </tr>

                <tr>
                    <th>Mana</th>
                    <td>@SessionState.Pfile.Mana / @SessionState.Pfile.MaxMana</td>
                    <th>Stamina</th>
                    <td>@SessionState.Pfile.Stamina / @SessionState.Pfile.MaxStamina</td>
                </tr>

                <tr>
                    <th>Strength</th>
                    <td>@SessionState.Pfile.Strength</td>
                    <th>Dexterity</th>
                    <td>@SessionState.Pfile.Dexterity</td>
                </tr>

                <tr>
                    <th>Constitution</th>
                    <td>@SessionState.Pfile.Constitution</td>
                    <th>Intelligence</th>
                    <td>@SessionState.Pfile.Intelligence</td>
                </tr>

                <tr>
                    <th>Wisdom</th>
                    <td>@SessionState.Pfile.Wisdom</td>
                    <th>Charisma</th>
                    <td>@SessionState.Pfile.Charisma</td>
                </tr>

                <tr>
                    <th>XP</th>
                    <td>@SessionState.Pfile.Xp / @SessionState.Pfile.XpNeeded</td>
                    <th>Gold</th>
                    <td>@SessionState.Pfile.Gold</td>
                </tr>

                <tr>
                    <th>Active Quest</th>
                    <td>@(SessionState.Pfile.ActiveQuest?.ToString() ?? "None")</td>
                    <th>Last Online</th>
                    <td>@(SessionState.Pfile.LastOnline?.ToString("g") ?? "Never")</td>
                </tr>

                <tr>
                    <th>Created At</th>
                    <td colspan="3">@SessionState.Pfile.CreatedAt.ToString("g")</td>
                </tr>
            </table>

        }

        <button class="close-btn" @onclick="Close">Close</button>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }

    private Task Close() => ShowChanged.InvokeAsync(false);
}


<style>
    .score-table.spaced tr {
        padding-bottom: 8px;
    }

    .score-table.spaced th,
    .score-table.spaced td {
        padding: 4px 10px;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        z-index: 1000;
    }

    .modal-window {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: #111;
        padding: 1.5rem;
        border: 2px solid #444;
        border-radius: 8px;
        color: #eee;
        width: auto;
        max-height: 80vh;
        overflow-y: auto;
        z-index: 1001;
    }

    .close-btn {
        margin-top: 1rem;
    }
</style>
