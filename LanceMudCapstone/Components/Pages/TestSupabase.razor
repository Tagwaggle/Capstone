@page "/test-supabase"
@inject SupabaseService Supa
@rendermode InteractiveServer

<h3>Supabase Client Test</h3>

<button @onclick="Test">Test Supabase</button>

@if (message is not null)
{
    <p>@message</p>
}

@code {
    private string? message;

    private async Task Test()
    {
        var ok = await Supa.TestConnectionAsync();
        message = ok ? "Supabase client initialized!" : "Supabase client failed.";
    }
}
