@page "/"
@using Radzen
@inject NotificationService NotificationService
@inject IJSRuntime JS
@rendermode InteractiveServer


<div class="home-root">
<PageTitle>Home</PageTitle>

<h1>Welcome Adventurer!</h1>
<RadzenNotification />
<HeroCard />
<div class="home-body">
        <RadzenText Style="color: white; font-size: 1rem;">
            Hello and Howdy! Welcome to Legends of the Lance. A place where you can drink an ale, tell a tale, or even dream to sail! Yes, this is an
            adventurers dream, here to have a bit of fun.
            </RadzenText>
<RadzenButton Text="Secret" Click="@ShowToast" Style="margin-top:20px;" />

    </div>
</div>
@code {
    async Task ShowToast()
    {
        try
        {

            var cookieValule = await JS.InvokeAsync<string>("cookieHelper.readCookie", "session");

            if (!string.IsNullOrWhiteSpace(cookieValule))
            {
                Console.WriteLine($"Value Found: {cookieValule}");
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Cookie Found",
                    Detail = $"Value: {cookieValule}",
                    Duration = 2000
                });

            }
            else
            {
                Console.WriteLine("Error");
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Cookie Not Found",
                    Detail = "No cookie returned.",
                    Duration = 2000
                });

            }
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error: {e}");
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Error Reading Cookie: {e}",
                Duration = 2000
            });

        }
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Secret",
            Detail = "You really think it would be that easy?",
            Duration = 2000
        });
    }
}
