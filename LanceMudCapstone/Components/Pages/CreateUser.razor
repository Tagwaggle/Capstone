@page "/create"
@layout MainLayout
@rendermode InteractiveServer

@using LanceMudCapstone.DTOs

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<div class="login-wrapper">
    <div class="login-card">
        <h2 class="login-title">Create Account</h2>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="error-message">@Message</div>
        }

        <EditForm Model="@model" OnValidSubmit="HandleCreate">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>Username</label>
                <InputText @bind-Value="model.Username" class="input" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <InputText @bind-Value="model.Email" class="input" />
            </div>

            <div class="form-group password-group">
                <label>Password</label>
                <div class="password-wrapper">
                    <InputText @bind-Value="model.Password"
                               type="@(_showPassword ? "text" : "password")"
                               class="input" />
                    <button type="button" class="show-btn" @onclick="ToggleShowPassword">
                        @(_showPassword ? "Hide" : "Show")
                    </button>
                </div>
            </div>

            <div class="form-group password-group">
                <label>Confirm Password</label>
                <div class="password-wrapper">
                    <InputText @bind-Value="model.ConfirmPassword"
                               type="@(_showPassword ? "text" : "password")"
                               class="input" />
                </div>
            </div>

            <button type="submit" class="login-button">Create Account</button>
        </EditForm>
    </div>
</div>

@code {
    private CreateUserModel model = new();
    private string? Message;
    private bool _showPassword = false;

    private HttpClient Api => HttpClientFactory.CreateClient("ServerAPI");

    public class CreateUserModel
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private void ToggleShowPassword()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleCreate()
    {
        Message = null;

        if (model.Password != model.ConfirmPassword)
        {
            Message = "Passwords do not match.";
            return;
        }

        var dto = new CreateUserDto
        {
            Username = model.Username,
            Email = model.Email,
            Password = model.Password
        };

        var response = await Api.PostAsJsonAsync("/api/auth/register", dto);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadFromJsonAsync<ApiErrorDto>();
            Message = error?.Message ?? "Account creation failed.";
            return;
        }

        Message = "User created. Redirecting to login...";
        await Task.Delay(1000);
        Nav.NavigateTo("/login");
    }
}
