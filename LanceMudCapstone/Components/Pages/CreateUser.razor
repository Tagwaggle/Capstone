@page "/create"
@layout MainLayout
@using LanceMudCapstone.DTOs
@inject SessionState SessionState
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject NotificationService NotificationService

<RadzenNotification />
<div class="login-wrapper">
<div style="justify-items: center; padding-top: 1.5rem;">
    <RadzenCard class="login-card-rz">
        <div class="login-title-rz">Create User</div>

        <RadzenTemplateForm TItem="CreateUserModel" Data="@model" Submit="HandleCreate" Method="post">
            <RadzenTextBox @bind-Value="model.Username" Name="Username" Placeholder="Username" Style="width:100%" />
            <RadzenRequiredValidator Component="Username" Text="Username is required" />
				<RadzenLengthValidator Component="Username" Text="Username must be between 3 and 20 characters" MinLength="3" MaxLength="20" />
            <RadzenTextBox @bind-Value="model.Email" Name="Email" Placeholder="Email" Style="width:100%;margin-top:1.5rem;" />
            <RadzenRequiredValidator Component="Email" Text="Email is required" />
				<RadzenEmailValidator Component="Email" Text="Invalid email format" />
            <RadzenPassword @bind-Value="model.Password" Name="Password" Placeholder="Password" Style="width:100%;margin-top:1.5rem;" />
            <RadzenRequiredValidator Component="Password" Text="Password is required!" />
            <RadzenPassword @bind-Value="model.ConfirmPassword" Name="ConfirmPassword" Placeholder="Confirm Password" Style="width:100%;margin-top:1.5rem;" />
            <RadzenRequiredValidator Component="ConfirmPassword" Text="Password is required!" />
            <RadzenButton Text="Create Account" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Style="width:50%;margin-top:1.5rem; justify-items: end;" Click="@(() => Console.WriteLine("Button clicked"))" />
        </RadzenTemplateForm>
    </RadzenCard>
</div>
</div>

@code {
    private CreateUserModel model = new();
    private string? Message;
    private bool _showPassword = false;

    private HttpClient Api => HttpClientFactory.CreateClient("ServerAPI");

    public class CreateUserModel
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private void ToggleShowPassword()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleCreate()
    {
        Console.WriteLine("Handle triggered");
        Message = null;
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Create Attempt",
            Detail = $"Attempting Creation for {model.Username}/{model.Email}.",
            Duration = 2000
        });

        if (model.Password != model.ConfirmPassword)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Password Missmatch",
                Detail = $"Creation for {model.Username} failed due to password missmatch.",
                Duration = 2000
            });
            Message = "Passwords do not match.";
            return;
        }

        var dto = new CreateUserDto
        {
            Username = model.Username,
            Email = model.Email,
            Password = model.Password
        };

        var response = await Api.PostAsJsonAsync("/api/auth/register", dto);

        if (!response.IsSuccessStatusCode)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Password Missmatch",
                Detail = $"Creation for {model.Username} failed due to database error.",
                Duration = 2000
            });
            var error = await response.Content.ReadFromJsonAsync<ApiErrorDto>();
            Message = error?.Message ?? "Account creation failed.";
            return;
        }

        Message = "User created. Redirecting to login...";
        await Task.Delay(1000);
        Nav.NavigateTo("/login");
    }
}
