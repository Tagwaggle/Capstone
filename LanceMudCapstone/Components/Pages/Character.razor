@page "/character"
@layout GameLayout

@inject SessionState SessionState
@inject CharacterService CharacterService
@inject LocalStorageService LocalStorage
@inject NavigationManager Nav

<div class="main-container">
    <RadzenStack Gap="1rem">
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Clear Selection" Click="() => ClearSelection()" />
                @if (SelectedCharacter != null)
                {
                    <div class="selected-summary" style="color:azure;"> Selected <strong>@SelectedCharacter.Name</strong> (Lvl @SelectedCharacter.Level @SelectedCharacter.Class)</div>
                }
            </RadzenStack>
        </RadzenCard>
        <RadzenDataGrid TItem="PlayerCharacterDto" Data="@characters" AllowPaging="true" PageSize="5" AllowSorting="true" AllowFiltering="true"
            FilterPopupRenderMode="PopupRenderMode.OnDemand" SelectionMode="DataGridSelectionMode.Single" @bind-Value="SelectedCharacters">
            <Columns>
                <RadzenDataGridColumn TItem="PlayerCharacterDto" Title="Character" Sortable="false" Filterable="false">
                    <Template Context="c">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".75rem">
                            <RadzenImage Path="@($"/images/classes/{c.Class}.svg")" Style="width: 40px; height: 40px;" class="rz-border-radius-2" />
                            <RadzenStack Gap="0">
                                <div class="char-name">@c.Name</div>
                                <div class="char-sub">@c.Class, Level: @c.Level</div>
                            </RadzenStack>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="Class" Title="Class" />
                <RadzenDataGridColumn Property="Level" Title="Level" />
                <RadzenDataGridColumn Property="RoomId" Title="Room" />
                
            </Columns>
        </RadzenDataGrid>
    </RadzenStack>
    <div class="character-action">
        <RadzenButton Text="Login" Click="@LoginCharacter" Disabled="@(!SelectedCharacterId.HasValue)" />
        <RadzenButton Text="Create New Character" Click="@CreateCharacter" ButtonStyle="ButtonStyle.Secondary" />
    </div>
</div>
@code {
    private List<PlayerCharacterDto>? characters;
    //    private PlayerCharacterDto? SelectedCharacter { get; set; }
    //    private int? SelectedCharacterId => SelectedCharacter?.CharacterId;
    private IList<PlayerCharacterDto> SelectedCharacters { get; set; } = new List<PlayerCharacterDto>();
    private PlayerCharacterDto? SelectedCharacter => SelectedCharacters.FirstOrDefault();
    private int? SelectedCharacterId => SelectedCharacter?.CharacterId;

    private bool _loaded, _loadInProgress;

    protected override void OnInitialized()
    {
        SessionState.OnChange += () => InvokeAsync(StateHasChanged);
        Console.WriteLine("OnInitialized Called Called");

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;
        Console.WriteLine("AfterRender Called");
        await TryLoadCharactersAsync();
    }

    private async void HandleSessionChanged()
    {
        Console.WriteLine("HandleSessionChange Called");
        await TryLoadCharactersAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task TryLoadCharactersAsync()
    {
        Console.WriteLine($"TryLoad Clicked: {SessionState.UserId} {SessionState.UserName}");
        
        await InvokeAsync(StateHasChanged);
        if (_loaded || _loadInProgress)
            return;

        if (SessionState.UserId == null)
            return;

        _loadInProgress = true;

        characters = (await CharacterService
            .GetCharactersByUserAsync(SessionState.UserId.Value))
            .ToList();

        _loaded = true;
        _loadInProgress = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoginCharacter()
    {
        if (!SelectedCharacterId.HasValue || characters == null)
            return;

        var selected = characters.First(c => c.CharacterId == SelectedCharacterId.Value);

        await LocalStorage.SetAsync("session.character", new
        {
            selected.CharacterId,
            selected.RoomId
        });

        await SessionState.SetCharacterAsync(selected);

        Nav.NavigateTo("/play");
    }

    private void ClearSelection()
    {
        SelectedCharacters = new List<PlayerCharacterDto>();
    }

    private void CreateCharacter()
        => Nav.NavigateTo("/character/create");

    public void Dispose()
    {
        SessionState.OnChange -= () => InvokeAsync(StateHasChanged);
    }
}
