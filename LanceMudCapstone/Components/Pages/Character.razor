@page "/character"
@rendermode InteractiveServer
@layout GameLayout

@using LanceMudCapstone.DTOs
@using LanceMudCapstone.Models
@using LanceMudCapstone.API

@inject IHttpClientFactory httpClientFactory
@inject SessionState SessionState
@inject CharacterService CharacterService;
@inject NavigationManager Nav

<div class="main-container">
    <h3>Character Select for @SessionState.UserName</h3>

    @if (SessionState.UserId == null)
    {
        <h1>Please login in.....</h1>
    }
    else if (characters == null)
    {
        <p>Loading Characters...</p>
        <p>@SessionState.UserName Waiting on load.</p>
    }
    else if (!characters.Any())
    {
        <p>No Current Characters, please create a character to continue</p>
    }
    else
    {
        <div class="character-list">
            <InputRadioGroup @bind-Value="SelectedCharacterId" Name="characterChoice">
                @foreach (var c in characters)
                {
                    <div class="character-item">
                        <InputRadio Value="@c.CharacterId" />
                        <span>@c.Name (Level @c.Level, @c.Class)</span>
                    </div>
                }
            </InputRadioGroup>
        </div>
    }
    <div class="character-action">
        @if (SelectedCharacterId.HasValue)
        {
            <button @onclick="LoginCharacter">Login</button>
        }
        else
        {
            <button disabled>Login</button>
        }

        <button @onclick="CreateCharacter">Create New Character</button>
    </div>
</div>

@code {
    private List<PlayerCharacterDto>? characters;
    private int? SelectedCharacterId;

    protected override async Task OnInitializedAsync()
    {
        if (SessionState.UserId != null)
        {
            characters = (await CharacterService.GetCharactersByUserAsync(SessionState.UserId.Value))
                         .ToList();
        }
    }

    private async Task LoginCharacter()
    {
        if (!SelectedCharacterId.HasValue)
            return;

        var selected = characters?.FirstOrDefault(c => c.CharacterId == SelectedCharacterId.Value);
        if (selected == null)
            return;

        // Set session state
        SessionState.Pfile = selected;

        if (selected.CharacterId != 0)
            await SessionState.SetCharacterAsync(selected.CharacterId);

        // Move player to their room
        await SessionState.MoveToRoom(selected.RoomId);

        Nav.NavigateTo("/play");
    }

    private void CreateCharacter() => Nav.NavigateTo("/character/create");
}
