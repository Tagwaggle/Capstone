@page "/character"
@rendermode InteractiveServer
@layout MainLayout

@inject SessionState SessionState
@inject CharacterService CharacterService
@inject LocalStorageService LocalStorage
@inject NavigationManager Nav

<div class="main-container">
    <h3>Character Select for @SessionState.UserName</h3>
    @if (!SessionState.Ready)
    {
        <p>waiting</p>
        <button @onclick="TryLoadCharactersAsync">Button</button>
    }
    else if (SessionState.UserId == null)
    {
        <p>Waiting for session… (uid) @SessionState.UserId</p>
        <p>If reload does not happen click button.</p>
        <button @onclick="TryLoadCharactersAsync">Button</button>
    }
    else if (!_loaded)
    {
        <p>Loading Characters…</p>
        <p>If reload does not happen click button.</p>
    }
    else if (!characters.Any())
    {
        <p>No characters found. Create one to continue.</p>
    }
    else
    {
        <div class="character-list">
            <InputRadioGroup @bind-Value="SelectedCharacterId">
                @foreach (var c in characters)
                {
                    <div class="character-item">
                        <InputRadio Value="@c.CharacterId" />
                        <span>@c.Name (Level @c.Level, @c.Class)</span>
                    </div>
                }
            </InputRadioGroup>
        </div>
    }

    <div class="character-action">
        <button @onclick="LoginCharacter" disabled="@(!SelectedCharacterId.HasValue)">
            Login
        </button>

        <button @onclick="CreateCharacter">Create New Character</button>
    </div>
</div>
@code {
    private List<PlayerCharacterDto>? characters;
    private int? SelectedCharacterId;
    private bool _loaded, _loadInProgress;

    protected override void OnInitialized()
    {
        SessionState.OnChange += HandleSessionChanged;
        Console.WriteLine("OnInitialized Called Called");

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;
        Console.WriteLine("AfterRender Called");
        await TryLoadCharactersAsync();
    }

    private async void HandleSessionChanged()
    {
        Console.WriteLine("HandleSessionChange Called");
        await TryLoadCharactersAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task TryLoadCharactersAsync()
    {
        Console.WriteLine($"TryLoad Clicked: {SessionState.UserId} {SessionState.UserName}");
       // await SessionState.InitializeAsync();
        await InvokeAsync(StateHasChanged);
        if (_loaded || _loadInProgress)
            return;

        if (SessionState.UserId == null)
            return;

        _loadInProgress = true;

        characters = (await CharacterService
            .GetCharactersByUserAsync(SessionState.UserId.Value))
            .ToList();

        _loaded = true;
        _loadInProgress = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoginCharacter()
    {
        if (!SelectedCharacterId.HasValue || characters == null)
            return;

        var selected = characters.First(c => c.CharacterId == SelectedCharacterId.Value);

        await LocalStorage.SetAsync("session.character", new
        {
            selected.CharacterId,
            selected.RoomId
        });

        await SessionState.SetCharacterAsync(selected);

        Nav.NavigateTo("/play");
    }

    private void CreateCharacter()
        => Nav.NavigateTo("/character/create");

    public void Dispose()
    {
        SessionState.OnChange -= HandleSessionChanged;
    }
}
