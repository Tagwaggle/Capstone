@page "/character/create"
@layout GameLayout

@using LanceMudCapstone.DTOs
@using LanceMudCapstone.Services
@using System.Text.Json

@inject SessionState SessionState
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject CharacterService CharacterService
<div class="login-wrapper">
<div class="create-wraper">
    <RadzenCard Style="max-width: 600px; margin: 2rem auto; padding: 2rem;">
        <RadzenText TextStyle="TextStyle.DisplayH5" Style="color: azure; margin-bottom: 1.5rem;">
            Create a Character - Level 1
        </RadzenText>
        <RadzenTemplateForm TItem="PlayerCharacterDto" Data="@form" Submit="SaveButton_Clicked">
            <RadzenRow Gap="1rem" Style="margin-bottom: 1rem;">
            <RadzenColumn Size="6">
                <RadzenLabel Style="color: azure;" Text="Name" />
                <RadzenTextBox Name="Name" @bind-Value="form.Name" Placeholder="Character Name" Style="width: 100%;" />
                <RadzenRequiredValidator Component="Name" Text="Name is required." />
            </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="1rem" Style="margin-bottom: 1rem;">
                <RadzenColumn Size="6">
                    <RadzenLabel Style="color: azure;" Text="Class" />
                    <RadzenDropDown Name="Class" @bind-Value="form.Class" Data="@_class" Placeholder="-- Class --" Style="width: 100%;" />
                    <RadzenRequiredValidator Component="Class" Text="Class is required." />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Style="color: azure;" Text="Race" />
                    <RadzenDropDown Name="Race" @bind-Value="form.Race" Data="@_race" Placeholder="-- Race --" Style="width: 100%;" />
                    <RadzenRequiredValidator Component="Race" Text="Race is required." />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="1rem" Style="margin-bottom: 1rem;">
                <RadzenColumn Size="6">
                    <RadzenLabel Style="color: azure;" Text="Law / Chaos" />
                    <RadzenDropDown Name="alignLaw" @bind-Value="alignLaw" Data="@_alignment2" Placeholder="-- Select --" Style="width: 100%;" />
                    <RadzenRequiredValidator Component="alignLaw" Text="Legality is Required." />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Style="color: azure;" Text="Good / Evil" />
                    <RadzenDropDown Name="alignVal" @bind-Value="alignVal" Data="@_alignment" Placeholder="-- Select --" Style="width: 100%;" />
                    <RadzenRequiredValidator Component="alignVal" Text="Value is required." />
                </RadzenColumn>
            </RadzenRow>
            <RadzenAlert AlertStyle="AlertStyle.Info" Style="margin-bottom: 1rem;" AllowClose="false">
                Skill Points Remaining: <strong>@Remaining</strong>
            </RadzenAlert>
            @foreach (var kvp in Stats)
            {
                <RadzenRow AlignItems="AlignItems.Center" Gap=".5rem;" Style="margin-bottom: .5rem;" >
                    <RadzenColumn Size="4" >
                        <RadzenLabel Text="@kvp.Key" />
                    </RadzenColumn>
                    <RadzenColumn Size="2" Style="test-align: center;">
                        <RadzenText TextStyle="TextStyle.Body1">
                            <b>@kvp.Value</b>
                        </RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                         <RadzenButton Icon="remove" ButtonStyle="ButtonStyle.Danger"
                                    Size="ButtonSize.Small"
                                    Click="() => AdjustStat(kvp.Key, -1)"
                                    Style="width:100%" />
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.Small"
                                      Click="() => AdjustStat(kvp.Key, 1)"
                                      Style="width:100%" />
                    </RadzenColumn>
                </RadzenRow>
            }

            <hr style="border-color: rgba(255,255,255,0.2); margin: 1.5rem 0;" />

            <RadzenRow Gap="1rem" Style="margin-bottom: 1.5rem;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="Max Health" />
                    <RadzenText TextStyle="TextStyle.H6" Style="color:white;">@Health</RadzenText>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="Starting Gold" />
                    <RadzenText TextStyle="TextStyle.H6" Style="color:white;">@Gold</RadzenText>
                </RadzenColumn>
            </RadzenRow>

            <RadzenButton ButtonType="ButtonType.Submit"
                          Text="Create Character"
                          ButtonStyle="ButtonStyle.Primary"
                          Style="width:100%" />

            
        </RadzenTemplateForm>
    </RadzenCard>
</div>
</div>

@code{
    int totalSkillPoints = 90;

    Dictionary<string, int> Stats = new()
    {
        { "Strength", 12},
        { "Wisdom", 12 },
        { "Intelligence", 12 },
        { "Dexterity", 12 },
        { "Constitution", 12 },
        { "Charisma", 12 }
};

    int Remaining => totalSkillPoints - Stats.Values.Sum();
    int Health = 20;
    int Gold => Remaining * 2;

    PlayerCharacterDto form = new();
    string alignLaw = string.Empty;
    string alignVal = string.Empty;
    string[] _race = { "Elf", "Human", "Dwarf", "Kender", "Half-Elf" };
    string[] _class = { "Warrior", "Mage", "Cleric", "Rogue", "Hunter", "Paladin", "Knight"};
    string[] _alignment = {"Good", "Neutral", "Evil"};
    string[] _alignment2 = {"Lawful", "Neutral", "Chaotic" };


    void AdjustStat(string stat, int delta)
    {
        if (Stats.ContainsKey(stat))
        {
            if (delta > 0 && Remaining <= 0) return;
            if (Stats[stat] + delta < 3) return;
            if (form.Race == "Elf" && (stat == "Wisdom" || stat == "Intelligence"))
            {
                if ((Stats[stat] + delta) > 19)
                {
                    return;
                }
            }
            else if (form.Race == "Human" && (stat == "Charisma"))
            {
                if ((Stats[stat] + delta) > 20)
                {
                    return;
                }
            }
            else if (form.Race == "Kender" && (stat == "Dexterity"))
            {
                if ((Stats[stat] + delta) > 20)
                {
                    return;
                }
            }
            else if (form.Race == "Dwarf" && (stat == "Constitution"))
            {
                if ((Stats[stat] + delta) > 20)
                {
                    return;
                }
            }
            else
            {
                if ((Stats[stat] + delta) > 18) return;
            }

            if(stat == "Constitution")
            {
                int temp = (Stats[stat] + delta);

                switch(temp)
                {
                    case 3:
                        Health = 10;
                        break;
                    case 4:
                        Health = 11;
                        break;
                    case 5:
                        Health = 12;
                        break;
                    case 6:
                        Health = 13;
                        break;
                    case 7:
                        Health = 14;
                        break;
                    case 8:
                        Health = 15;
                        break;
                    case 9:
                        Health = 16;
                        break;
                    case 10:
                        Health = 17;
                        break;
                    case 11:
                        Health = 18;
                        break;
                    case 12:
                        Health = 20;
                        break;
                    case 13:
                        Health = 22;
                        break;
                    case 14:
                        Health = 24;
                        break;
                    case 15:
                        Health = 26;
                        break;
                    case 16:
                        Health = 28;
                        break;
                    case 17:
                        Health = 32;
                        break;
                    case 18:
                        Health = 34;
                        break;
                    case 19:
                        Health = 38;
                        break;
                    case 20:
                        Health = 42;
                        break;
                }
            }
            Stats[stat] += delta;
        }
    }
    async Task SaveButton_Clicked()
    {
        if (string.IsNullOrWhiteSpace(form.Name) ||
            string.IsNullOrWhiteSpace(form.Class) ||
            string.IsNullOrWhiteSpace(form.Race)) return;

        switch (form.Class.ToLower())
        {
            case "mage":
            case "wizard":
            case "sorcerer":
                form.MaxMana = 30;
                form.Mana = 30;
                form.MaxStamina = 10;
                form.Stamina = 10;
                break;

            case "cleric":
            case "paladin":
                form.MaxMana = 20;
                form.Mana = 20;
                form.MaxStamina = 15;
                form.Stamina = 15;
                break;

            case "warrior":
            case "fighter":
            case "knight":
                form.MaxMana = 0;
                form.Mana = 0;
                form.MaxStamina = 25;
                form.Stamina = 25;
                break;

            case "rogue":
            case "ranger":
            case "hunter":
                form.MaxMana = 0;
                form.Mana = 0;
                form.MaxStamina = 30;
                form.Stamina = 30;
                break;

            default:
                form.MaxMana = 0;
                form.Mana = 0;
                form.MaxStamina = 20;
                form.Stamina = 20;
                break;
        }

        form.UserId = SessionState.UserId ?? 1;
        if (form.UserId == 1)
        {
            Console.WriteLine("Cannot save character: no active user session.");
            return;
        }

        if (alignLaw == "Neutral" && alignVal == "Neutral")
            form.Alignment = "True Neutral";
        else
        {
            form.Alignment = $"{alignLaw} {alignVal}";
        }
        form.Strength = Stats["Strength"];
        form.Wisdom = Stats["Wisdom"];
        form.Intelligence = Stats["Intelligence"];
        form.Dexterity = Stats["Dexterity"];
        form.Constitution = Stats["Constitution"];
        form.Charisma = Stats["Charisma"];
        form.MaxHealth = Health;
        form.RoomId = 2;
        form.Gold = Gold;
        form.ActiveQuest = null;
        form.LastOnline = null;

        Console.WriteLine($"Saving {form.Name}, Player ID: {SessionState.UserId}");

        var charId = await CharacterService.CreateCharacterAsync(form);
        Nav.NavigateTo("/character");

    }

}