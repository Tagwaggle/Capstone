@page "/settings"
@layout GameLayout

@inject SessionState SessionState
@inject IHttpClientFactory HttpClientFactory
@inject DialogService DialogService
@inject UserService UserService
@inject NotificationService NotificationService
@inject NavigationManager Nav

@using LanceMudCapstone.Enums
@using LanceMudCapstone.DTOs
@using LanceMudCapstone.Services
@using LanceMudCapstone.Components.Settings

<div class="login-wrapper">
<RadzenCard class="settings-card">

    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="1.5rem"
                 AlignItems="AlignItems.Center">

        <AvatarFab CurrentIcon="@SessionState.UserIcon"
                   OnIconChanged="OnAvatarChanged" />

        <RadzenStack Gap="0.25rem">
            <RadzenText TextStyle="TextStyle.Overline" class="label-text">User Name</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" class="value-text">
                <b>@SessionState.UserName</b>
            </RadzenText>

            <RadzenText TextStyle="TextStyle.Overline" class="label-text rz-mt-4">Password</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" class="value-text">
                <b>***</b>
            </RadzenText>

            <RadzenButton Text="Change Password"
                          Click="OpenPasswordDialog"
                          class="btn-lunar rz-mt-2"
                          Style="width: fit-content;" />
        </RadzenStack>

    </RadzenStack>

    <div class="settings-divider"></div>

    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.Overline" class="label-text">Email</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" class="value-text">
            <b>@currentEmail</b>
        </RadzenText>

        <RadzenText TextStyle="TextStyle.Overline" class="label-text rz-mt-4">New Email</RadzenText>
        <InputText class="form-entry" @bind-Value="newEmail" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 Gap="1rem"
                 class="rz-mt-6">

        <RadzenButton Text="Save Email"
                      Click="EmailButton_Clicked"
                      class="btn-lunar" />

        <RadzenButton Text="Back"
                      NavigateTo="/character"
                      class="btn-secondary" />
    </RadzenStack>

</RadzenCard>
</div>
@code {
    private string currentEmail = string.Empty;
    private string newEmail = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("ServerAPI");
        try
        {
            if (SessionState.UserId == null) return;
            currentEmail = await UserService.GetUserEmail(SessionState.UserId.Value);

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching email: {ex.Message}");
        }
    }

    private async Task EmailButton_Clicked()
    {
        if (string.IsNullOrWhiteSpace(newEmail.Trim()))
            return;

        var client = HttpClientFactory.CreateClient("ServerAPI");
        var dto = new UserEmailDto { Email = newEmail.Trim() };

        var response = await client.PutAsJsonAsync(
            $"api/users/{SessionState.UserId}/email", dto);

        if (response.IsSuccessStatusCode)
        {
            if (SessionState.UserId == null) return;
            currentEmail = newEmail.Trim();
            await UserService.UpdateUserEmailAsync(SessionState.UserId.Value, currentEmail);
            SessionState.NotifyStateChange();
            newEmail = string.Empty;
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = "E-Mail Address Updated",
                Duration = 2000
            });

        }
        else
        {
            Console.WriteLine($"Error writing email: {response.StatusCode}");
        }
    }

    private async Task OnAvatarChanged(UserIcon newIcon)
    {
        if (SessionState.UserId == null)
        {
            return;
        }

        var results = await UserService.UpdateUserIconAsync(SessionState.UserId.Value, newIcon);
        if(results)
        {
            SessionState.UserIcon = newIcon;
            SessionState.NotifyStateChange();
        }
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Success",
            Detail = "User Icon Updated",
            Duration = 2000
        });

    }
    private void Back_Clicked()
    {
        Nav.NavigateTo("/character");
    }
    private async Task OpenPasswordDialog()
    {
        Console.WriteLine("Open clicked");

        if (SessionState.UserId == null) return;
        if (string.IsNullOrWhiteSpace(SessionState.UserName)) return;


        var result = await DialogService.OpenAsync<PasswordDialog>(
            "Change Password",
            new Dictionary<string, object?>
                {
                { "Username", SessionState.UserName ?? string.Empty },
                { "UserId", SessionState.UserId.Value }
                },
            new DialogOptions { Width = "420px", Height = "auto" }
            );
        Console.WriteLine($"{SessionState.UserName} : {SessionState.UserId.Value}");

        if (result is bool success && success)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = "Password Updated",
                Duration = 2000
            });
        }
    }
}
