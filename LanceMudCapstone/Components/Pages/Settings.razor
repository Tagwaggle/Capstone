@page "/settings"
@layout GameLayout
@inject SessionState SessionState
@inject IHttpClientFactory HttpClientFactory
@using LanceMudCapstone.DTOs
@using LanceMudCapstone.API

@rendermode InteractiveServer

@if (showPasswordPopup)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <h3>Change Password</h3>

            <div class="form-group">
                <label>Old Password</label><br/>
                <InputText type="password" @bind-Value="oldPassword" class="form-entry" />
            </div>

            <div class="form-group">
                <label>New Password</label><br />
                <InputText type="password" @bind-Value="newPassword" class="form-entry" />
            </div>

            <div class="form-group">
                <label>Confirm New Password</label><br />
                <InputText type="password" @bind-Value="confirmPassword" class="form-entry" />
            </div>

            <div class="modal-actions">
                <button class="setting-button" @onclick="SubmitPasswordChange">Submit</button>
                <button class="setting-button" @onclick="HidePasswordPopup">Cancel</button>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="error-text">@errorMessage</p>
            }
        </div>
    </div>
}

<div class="setting-wrapper">
    <div class="setting-card">
        <h2>Settings for @SessionState.UserName</h2>
          @if (_user is null)
        {
            <p>Loading user data...</p>
        }
        else
        {
        <table class="setting-table">
            <tr>
                <td>User Name</td>
                <td>@SessionState.UserName</td>
            </tr>
            <tr>
                <td>Password</td>
                <td style="color: grey">***</td>
            </tr>
        </table>
        <button class="setting-button" @onclick="ShowPasswordPopup">Change Password</button>
        <table class="setting-table">
            <tr>
                <td>User Email</td>
                <td>@_user.Email</td>
                </tr>
                <tr>
                    <td>New Email</td>
                <td><InputText class="form-entry" @bind-Value="newEmail" id="newEmail" /></td>
            </tr>
            <tr>
                <td>E-Mail</td>
                <td style="color: grey">@_user.Email</td>
            </tr>
        </table>
        <button class="setting-button" @onclick="EmailButton_Clicked">Change Email</button>
        }
    </div>
</div>

@code {
    private string newEmail { get; set; } = string.Empty;
    private UserDto? _user;
    private bool showPasswordPopup = false;
    private string oldPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string errorMessage = string.Empty;

    private void ShowPasswordPopup() => showPasswordPopup = true;
    private void HidePasswordPopup() => showPasswordPopup = false;

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("ServerAPI");

        try
        {
            _user = await client.GetFromJsonAsync<UserDto>($"api/users/Select/{SessionState.UserId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching user: {ex.Message}");
        }
    }
    private async Task EmailButton_Clicked()
    {
        if (string.IsNullOrWhiteSpace(newEmail.Trim())) return;

        var client = HttpClientFactory.CreateClient("ServerAPI");

        var dto = new UserEmailDto { Email = newEmail.Trim() };

        var response = await client.PutAsJsonAsync($"api/users/{SessionState.UserId}/email", dto);

        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine($"Email updated to: {newEmail.Trim()}");
            newEmail = string.Empty;
            _user = await client.GetFromJsonAsync<UserDto>($"api/users/Select/{SessionState.UserId}");
        }
        else
        {
            Console.WriteLine($"Error writing email: {response.StatusCode}");
        }
    }
    private async Task SubmitPasswordChange()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(oldPassword) || string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "All fields are required";
            return;
        }
        if (newPassword != confirmPassword)
        {
            errorMessage = "The new passwords must match";
            return;
        }

        var dto = new LoginDto
        {
            Username = _user?.Username.Trim() ?? string.Empty,
            Password = oldPassword
        };

        var client = HttpClientFactory.CreateClient("ServerAPI");
        var response = await client.PostAsJsonAsync("/api/auth/login", dto);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadFromJsonAsync<ApiErrorDto>();
            errorMessage =  "Password mismatch.";
            return;
        }

        var dto2 = new PasswordDto { Password = newPassword };
        var response2 = await client.PutAsJsonAsync($"api/users/{SessionState.UserId}/password", dto2);

        if (response2.IsSuccessStatusCode)
        {
            HidePasswordPopup();
            Console.WriteLine($"Username: {SessionState.UserName} succesfully changed password");

        }
        else
        {
            errorMessage = "Failed to update password";
            Console.WriteLine($"Username: {SessionState.UserName} failed to chang password");

        }

    }

}
