
@using Radzen.Blazor
@using Radzen
@implements IDisposable
@inject SessionState SessionState
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SessionRepository SessionRepo




<div class="lunitari-header">
    <div class="header-left">
        <RadzenSidebarToggle Click="CloseSidebar">🍔 Sidebar</RadzenSidebarToggle>

    </div>
    <div class="header-center">

        <RadzenCardGroup Responsive="true" class="stats-group">

            <RadzenCard Variant="Variant.Outlined" class="stat-card">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.H5" Style="color:white;">HP</RadzenText>
                    <RadzenProgressBar class="hp-bar" Value="@SessionState.Pfile.Health" Max="@SessionState.Pfile.MaxHealth" ShowValue="false" Style="--rz-progressbar-height: 0.75rem;" />
                </RadzenStack>
            </RadzenCard>
            @if(@SessionState.Pfile.MaxMana != 0)
            {
            <RadzenCard Variant="Variant.Outlined" class="stat-card">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.H5" Style="color:white;">Mana</RadzenText>
                    <RadzenProgressBar class="mana-bar" Value="@SessionState.Pfile.Mana" Max="@SessionState.Pfile.MaxMana" ShowValue="false" Style="--rz-progressbar-height: 0.75rem;" />
                </RadzenStack>
            </RadzenCard>
            }
            @if(@SessionState.Pfile.MaxStamina != 0)
            {
            <RadzenCard Variant="Variant.Outlined" class="stat-card">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.H5" Style="color:white;">Stamina</RadzenText>
                    <RadzenProgressBar class="stamina-bar" Value="@SessionState.Pfile.Stamina" Max="@SessionState.Pfile.MaxStamina" ShowValue="false" Style="--rz-progressbar-height: 0.75rem;" />
                </RadzenStack>
            </RadzenCard>
            }
        </RadzenCardGroup>

    </div>


    
    @if (SessionState?.UserId != null)
    {
        <div class="rz-p-12 rz-text-align-center">
            <RadzenProfileMenu>
                <Template>
                    <RadzenImage Path="images/classes/default.svg" Style="height: 1.5rem">
                    </RadzenImage>
                </Template>
                <ChildContent>
                    <RadzenProfileMenuItem Text="Settings" Icon="settings" Path="settings" />
                    <RadzenProfileMenuItem Text="Logout" Icon="logout" Path="logout" />
                </ChildContent>
            </RadzenProfileMenu>
        </div>
    }
    </div>

@code {
    [Parameter] public bool Compact { get; set; } = false;
    [Parameter] public bool sidebar1Expanded { get; set; } = true;
    [Parameter] public EventCallback<bool> sidebar1ExpandedChanged { get; set; }

    private async Task CloseSidebar()
    {
        sidebar1Expanded = !sidebar1Expanded;
        await sidebar1ExpandedChanged.InvokeAsync(sidebar1Expanded);
        Console.WriteLine($"Sidebar clicked {sidebar1Expanded}");
    }
    private async Task Settings_Clicked()
    {
        if(SessionState.CharacterId != null)
        {
            await SessionState.ClearCharacterAsync();
            Nav.NavigateTo("/settings");
        }
    }
    private async Task Logout()
    {
        var cookieValue = await JS.InvokeAsync<string>("cookieHelper.readCookie", "session");

        if (!string.IsNullOrWhiteSpace(cookieValue))
        {
            SessionRepo.DeleteSession(cookieValue);
        }   

        await JS.InvokeVoidAsync("cookieHelper.eraseCookie", "session");

        await SessionState.ClearCharacterAsync();

        Nav.NavigateTo("/login", forceLoad: true);
    }
    protected override void OnInitialized()
    {
        SessionState.OnChange += StateHasChanged;
        base.OnInitialized();
    }
    public void Dispose()
    {
        SessionState.OnChange -= StateHasChanged;
    }
}
