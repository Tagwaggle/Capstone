
@using Radzen.Blazor
@using Radzen
@using LanceMudCapstone.Services

@implements IDisposable
@inject SessionState SessionState
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SessionRepository SessionRepo
@inject UserService UserService
@inject LogoutService logoutService
@inject DialogService DialogService



<div class="lunitari-header">
    <div class="header-left">
        <RadzenSidebarToggle Click="CloseSidebar">🍔 Sidebar</RadzenSidebarToggle>

    </div>

    <div class="header-center">
        <h1 class="glyph-title">
            <span style="--i:0" data-rune="ᚦ">L</span>
            <span style="--i:1" data-rune="ᚱ">e</span>
            <span style="--i:2" data-rune="ᚨ">g</span>
            <span style="--i:3" data-rune="ᚾ">e</span>
            <span style="--i:4" data-rune="ᛞ">n</span>
            <span style="--i:5" data-rune="ᛋ">d</span>
            <span style="--i:6" data-rune="ᚲ">s</span>
            <span style="--i:7">&nbsp;</span>
            <span style="--i:8" data-rune="ᛟ">o</span>
            <span style="--i:9" data-rune="ᚠ">f</span>
            <span style="--i:10">&nbsp;</span>
            <span style="--i:11" data-rune="ᛏ">t</span>
            <span style="--i:12" data-rune="ᚺ">h</span>
            <span style="--i:13" data-rune="ᛖ">e</span>
            <span style="--i:14">&nbsp;</span>
            <span style="--i:15" data-rune="ᛚ">L</span>
            <span style="--i:16" data-rune="ᚨ">a</span>
            <span style="--i:17" data-rune="ᚾ">n</span>
            <span style="--i:18" data-rune="ᚲ">c</span>
            <span style="--i:19" data-rune="ᛖ">e</span>
        </h1>
    </div>


    
    @if (SessionState?.UserId != null)
    {
        <div class="rz-p-12 rz-text-align-center">
            <RadzenProfileMenu Click="@OnProfileMenuClick">
                <Template>
                    <RadzenImage Path="@UserIconHelper.GetIconPath(SessionState.UserIcon)" Style="height: 1.5rem">
                    </RadzenImage>
                </Template>
                <ChildContent>
                    <RadzenProfileMenuItem Text="Settings" Icon="settings" Value="settings" />
                    <RadzenProfileMenuItem Text="Who" Icon="accessibility" Value="who" />
                    <RadzenProfileMenuItem Text="Logout" Icon="logout" Value="logout" />
                </ChildContent>
            </RadzenProfileMenu>
        </div>
    }
    </div>

@code {
    [Parameter] public bool Compact { get; set; } = false;
    [Parameter] public bool sidebar1Expanded { get; set; } = true;
    [Parameter] public EventCallback<bool> sidebar1ExpandedChanged { get; set; }

    private async Task CloseSidebar()
    {
        sidebar1Expanded = !sidebar1Expanded;
        await sidebar1ExpandedChanged.InvokeAsync(sidebar1Expanded);
        Console.WriteLine($"Sidebar clicked {sidebar1Expanded}");
    }
    private async Task Settings_Clicked()
    {
        if(SessionState.CharacterId != null)
        {
            await SessionState.ClearCharacterAsync();
            Nav.NavigateTo("/settings");
        }
    }
    private async Task Logout()
    {
        var cookieValue = await JS.InvokeAsync<string>("cookieHelper.readCookie", "session");

        if (!string.IsNullOrWhiteSpace(cookieValue))
        {
            SessionRepo.DeleteSession(cookieValue);
        }   

        await JS.InvokeVoidAsync("cookieHelper.eraseCookie", "session");

        await SessionState.ClearCharacterAsync();

        Nav.NavigateTo("/login", forceLoad: true);
    }
    private async Task DisplayWho()
    {
        await DialogService.OpenAsync<WhoComp>(
            "Who's Online",
            new Dictionary<string, object?>(),
            new DialogOptions
                {
                    Width = "800px",
                    Height = "800px",
                    Resizable = true,
                    Draggable = true,
                    CloseDialogOnOverlayClick = true,
                    CloseDialogOnEsc = true
                }
        );
    }
    protected override void OnInitialized()
    {
        SessionState.OnChange += () => InvokeAsync(StateHasChanged);
        base.OnInitialized();
    }
    public void Dispose()
    {
        SessionState.OnChange -= () => InvokeAsync(StateHasChanged);
    }
    private async Task OnProfileMenuClick(RadzenProfileMenuItem item)
    {
        switch (item.Value?.ToString())
        {
            case "settings":
                Nav.NavigateTo("/settings");
                break;
            case "logout":
                await logoutService.RequestLogoutAsync();
                break;
            case "who":
                await DisplayWho();
                break;
        }
    }
}
