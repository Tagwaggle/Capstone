
@inject CharacterService CharacterService

@using LanceMudCapstone.DTOs
@using Radzen
@using Radzen.Blazor

<div class="login-wrapper">
    <RadzenCard Style="margin: 2rem;">
        <RadzenHeading Size="H3" Style="color: white" Text="Who Is Online" />

        @if (players == null)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"
                               Style="width: 100%; margin-top: 1rem;" />
        }
        else if (!players.Any())
        {
            <RadzenAlert Severity="Info" Style="margin-top: 1rem;">
                No characters are currently online.
            </RadzenAlert>
        }
        else
        {
            <RadzenDataList Data="@players"
                            TItem="PlayerCharacterDto"
                            WrapItems="true"
                            AllowPaging="false"
                            Style="margin-top: 1rem;">

                <Template Context="p">
                    <RadzenCard Style="width: 300px; margin: 1rem;">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     Gap="10px">
                            <RadzenImage Path=@("/images/classes/" + p.Class.ToLower() + ".svg")
                                         Style="width:64px;height:64px;" />


                            <div style="color:azure">
                            <RadzenStack Gap="0">
                                <RadzenText Style="color: azure" TextStyle="TextStyle.Overline">User</RadzenText>
                                    <RadzenText Style="color: azure" TextStyle="TextStyle.Body1"><b>@p.Username</b></RadzenText>

                                <RadzenText TextStyle="TextStyle.Overline"
                                            Style="color: azure; margin-top: 0.5rem;">Character</RadzenText>
                                    <RadzenText Style="color: azure" TextStyle="TextStyle.Body1"><b>@p.Name</b></RadzenText>
                            </RadzenStack>
                            </div>
                        </RadzenStack>

                        <hr style="border: none; background-color: rgba(0,0,0,.2); height: 1px; margin: 1rem 0;" />

                        <RadzenRow>
                            <RadzenColumn Size="6">
                                <RadzenBadge BadgeStyle="BadgeStyle.Primary"
                                             Text=@($"Level {p.Level}") />
                            </RadzenColumn>

                            <RadzenColumn Size="6" class="rz-text-align-end">
                                <RadzenBadge BadgeStyle="BadgeStyle.Secondary"
                                             Text=@($"{IdleMinutes(p.LastCommand)}m idle") />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenCard>
                </Template>
            </RadzenDataList>
        }
    </RadzenCard>
</div>
@code {
    private IEnumerable<PlayerCharacterDto>? players;

    protected override async Task OnInitializedAsync()
    {
        players = await CharacterService.GetOnlineCharactersAsync();
    }

    private int IdleMinutes(DateTime? last)
        => last.HasValue ? (int)(DateTime.UtcNow - last.Value).TotalMinutes : 0;
}
