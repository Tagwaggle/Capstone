@inherits LayoutComponentBase
@inject SessionState SessionState
@inject NavigationManager Nav

<header>
    <LunitariHeader />
    <GameNavBar />
</header>


<main>
    @if (!_hydrated)
    {
        <LoadingPage OnFinished="@(() => _hydrated = true)" />
    }
    else
    {
        @Body
    }
</main>
<footer>
<AppFooter />
</footer>
@code {
    private bool _hydrated = false;

    protected override void OnInitialized()
    {
        SessionState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SessionState.OnChange -= StateHasChanged;
    }
}
