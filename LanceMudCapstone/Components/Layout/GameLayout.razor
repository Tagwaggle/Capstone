@inherits LayoutComponentBase
@inject SessionState SessionState

<div class="page">
    <header class="top-row">
        <GameHeader />
    </header>

    <div class="body">
        <nav class="sidebar">
            @if (SessionState.Ready && SessionState.CommandBox)
            {
                <GameNavBar />
            }
        </nav>

        <main>
            @if (!SessionState.Ready)
            {
                <LoadingPage OnFinished="SessionState.InitializeAsync" />
            }
            else
            {
                @Body
            }
        </main>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // Listen for session changes and trigger UI refresh
        SessionState.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !SessionState.Ready)
        {
            // Trigger session initialization after first render to avoid prerender JS issues
            await SessionState.InitializeAsync();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        SessionState.OnChange -= StateHasChanged;
    }
}
