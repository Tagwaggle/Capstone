@inherits LayoutComponentBase
@inject SessionState SessionState
@inject NavigationManager Nav


<div class="page">
    <header class="top-row">
        <LunitariHeader />
    </header>

    <div class="body">


        <main>
            @if (!_hydrated)
            {
                <LoadingPage OnFinished="@(() => _hydrated = true)" />
            }
            else
            {
                @Body
            }
        </main>
    </div>

    <footer>
        <AppFooter />
    </footer>
</div>


@code {
    private bool _hydrated = false;

    protected override void OnInitialized()
    {
        SessionState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SessionState.OnChange -= StateHasChanged;
    }
}
