@rendermode InteractiveServer
@inherits LayoutComponentBase
@using LanceMudCapstone.Components.Gateway
@using Radzen
@using Radzen.Blazor
@inject SessionState SessionState



<RadzenLayout>

    <RadzenHeader>
        <LunitariHeader sidebar1Expanded="@sidebar1Expanded"
                        sidebar1ExpandedChanged="@OnSidebarChanged" />
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebar1Expanded">
        <GameNavBar />
    </RadzenSidebar>

    <RadzenBody>
        @Body
    </RadzenBody>

    <RadzenFooter>
        <AppFooter />
    </RadzenFooter>

</RadzenLayout>

@code {
    private bool sidebar1Expanded = true;

    private void OnSidebarChanged(bool value)
    {
        sidebar1Expanded = value;
        StateHasChanged();
    }
}
