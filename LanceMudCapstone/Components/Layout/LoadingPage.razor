@page "/loading"
@inherits ComponentBase

<div class="loading-wrapper">
    <div class="walkout">
        <span class="guy">🧑‍🔧</span>
    </div>
    <div class="hammering">
        <span class="hammer">🔨</span>
        <span class="dust">💨</span>
    </div>
    <p>Preparing your adventure...</p>
</div>

@code {
    [Parameter] public EventCallback OnFinished { get; set; }

    [Inject] private SessionState SessionState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Wait a little so user sees the animation
        await Task.Delay(800);

        // Hydrate session (user + character)
        if (!SessionState.FirstLoadComplete)
        {
            await SessionState.EnsureInitializedAsync();
        }

        // Keep cinematic visible for at least 2.5 seconds
        await Task.Delay(1700);

        if (OnFinished.HasDelegate)
            await OnFinished.InvokeAsync();
    }
}
