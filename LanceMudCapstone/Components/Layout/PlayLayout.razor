@inherits LayoutComponentBase
@inject SessionState SessionState

<div class="page">
    <header class="top-row">
        <LunitariHeader />
    </header>

    <div class="body">
        <main>
            @Body
        </main>
    </div>

    <footer class="play-footer">
        <AppFooter />
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        SessionState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SessionState.OnChange -= StateHasChanged;
    }
}
