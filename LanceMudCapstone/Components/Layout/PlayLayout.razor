@inherits LayoutComponentBase
@inject SessionState SessionState
@inject NavigationManager Nav

<div class="page">
    <header class="top-row">
        <LunitariHeader />
    </header>
    @if (!_readyToRender)
    {
                <LoadingPage OnFinished="() => _readyToRender = true" />
    }
    else
    {
    <main class="play-body">
        @Body
    </main>
    }
    
    

    <footer class="play-footer">
        <AppFooter />
    </footer>
</div>

@code {
    private bool _readyToRender = false;

 /*   protected override void OnInitialized()
    {
        // Guard: no active session → back to character select
        if (!SessionState.IsLoggedIn || SessionState.Pfile == null)
        {
            Nav.NavigateTo("/character", true);
        }
    }
    */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SessionState.InitializeAsync();
            await SessionState.TryHydrateCharacterAsync();

            _readyToRender = true;
            StateHasChanged();
        }

        if (_readyToRender && SessionState.Pfile == null)
        {
            Nav.NavigateTo("/character", true);
        }
    }
}
