@inherits LayoutComponentBase
@inject SessionState SessionState
@rendermode InteractiveServer


<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<LanceMudCapstone.Components.Gateway.AuthGate />

<div class="page">
    <header class="top-row">
        <PlayHeader />
    </header>
    <main>
        @Body
    </main>
    <footer class="play-footer">
        <AppFooter />
    </footer>
</div>

@code {

    protected override void OnInitialized()
    {
        SessionState.OnChange += () => InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionState.OnChange -= () => InvokeAsync(StateHasChanged);

    }
}
