@inherits LayoutComponentBase
@inject SessionState SessionState
@inject NavigationManager Nav

<div class="page">
    <header class="top-row">
        <LunitariHeader />
        <!-- Optional: add a navbar here for basic in-game links -->
    </header>

    <main class="play-body">
        @if (!_hydrated)
        {
            <LoadingPage OnFinished="@(() => _hydrated = true)" />
        }
        else
        {
            @Body
        }
    </main>

    <footer class="play-footer">
        <AppFooter />
    </footer>
</div>

@code {
    private bool _hydrated = false;

    protected override void OnInitialized()
    {
        SessionState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SessionState.OnChange -= StateHasChanged;
    }
}
